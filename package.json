{
  "name": "vite-threejs-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "download:aristotle": "node scripts/download-aristotle-tomb.mjs",
    "download:draco": "node scripts/download-draco-decoder.mjs",
    "compress:assets": "node scripts/compress-assets.mjs",
    "postinstall": "npm run download:draco && npm run generate:favicon",
    "verification": "playwright test"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.7.2",
    "@types/three": "^0.180.0",
    "@types/web": "^0.0.279",
    "playwright": "^1.57.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.0.0",
    "vite": "^7.1.9"
  }
}
