{
  "name": "vite-threejs-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000",
    "start": "vite --host 0.0.0.0 --port 8000",
    "build": "vite build && node scripts/ensure-three-bundled.mjs && node scripts/build-bundleless-sources.mjs && node scripts/copy-bundleless-sources.mjs && node scripts/sanitize-bare-import-text.mjs",
    "deploy": "npm run build"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.7.2",
    "@types/three": "^0.180.0",
    "@types/web": "^0.0.279",
    "playwright": "^1.57.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.0.0",
    "vite": "^7.1.9"
  }
}
