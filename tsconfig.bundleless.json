{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".bundleless",
    "allowJs": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "docs", "dist", ".bundleless"]
}
