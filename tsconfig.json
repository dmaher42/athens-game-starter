{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": false,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@app/types": ["src/types/index"],
      "@app/types/*": ["src/types/*"]
    }
  },
  "include": [
    // Stage 5 migration targets — toggle these globs on or off as their
    // JavaScript sources convert to TypeScript.
    "src/state/**/*.ts",
    "src/input/**/*.ts",
    "src/ui/**/*.ts",
    // Existing TypeScript entry points that must remain checked regardless of
    // the staged migration scope.
    "src/main.ts",
    "src/utils/**/*.ts",
    "src/types/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/types/**/*.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "docs", "dist"]
}
